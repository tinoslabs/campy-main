# ---------------------------------------------------------------------------
# Campy AI — environment configuration
# Copy to .env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=campy.ai,www.campy.ai
DJANGO_CSRF_TRUSTED_ORIGINS=https://campy.ai,https://www.campy.ai
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database (production) --------------------------------------------------
# Omit to use SQLite, which is fine for evaluation but not for real load.
DATABASE_URL=postgres://campyai:password@localhost:5432/campyai

# --- Cache / queue ----------------------------------------------------------
# With Redis set, Celery runs tasks in the background instead of inline.
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Email ------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Campy AI <no-reply@campy.ai>

# --- Razorpay (India) -------------------------------------------------------
# Dashboard → Settings → API Keys. The webhook secret is set when you add the
# webhook endpoint pointing at https://your-host/webhooks/razorpay/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# --- Stripe (international) -------------------------------------------------
# Webhook endpoint: https://your-host/webhooks/stripe/
# Subscribe to checkout.session.completed, payment_intent.succeeded,
# payment_intent.payment_failed and invoice.paid
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- Campy AI product tuning -----------------------------------------------
CAMPY_BRAND_NAME=Campy AI
CAMPY_SUPPORT_EMAIL=support@campy.ai
CAMPY_MODEL_ROOT=/var/lib/campyai/models
CAMPY_DATASET_ROOT=/var/lib/campyai/datasets
DJANGO_MEDIA_ROOT=/var/lib/campyai/media

# Frames analysed per second, and the resolution they are analysed at.
# Lower = cheaper. 480x270 @ 6fps is the tested default.
CAMPY_WORKER_TARGET_FPS=6
CAMPY_WORKER_FRAME_WIDTH=480
CAMPY_WORKER_FRAME_HEIGHT=270

# Retention. Also enforced per-workspace by the subscription package.
CAMPY_EVENT_RETENTION_DAYS=90
CAMPY_SNAPSHOT_RETENTION_DAYS=30

# Pixelate the faces of people who are not enrolled, in every stored snapshot.
CAMPY_PRIVACY_BLUR=False

# --- Optional ---------------------------------------------------------------
SENTRY_DSN=
DJANGO_LOG_LEVEL=INFO
